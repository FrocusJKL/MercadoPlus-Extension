{
  "manifest_version": 3,
  "name": "Mercado Plus",
  "description": "Una experiencia más limpia y productiva para Mercado Libre.",
  "version": "1.0.0",
  "action": { "default_title": "Mercado Plus", "default_popup": "popup.html" },
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": [
      "https://*.mercadolibre.com/*",
      "https://*.mercadolibre.com.ar/*",
      "https://*.mercadolibre.com.bo/*",
      "https://*.mercadolibre.com.br/*",
      "https://*.mercadolibre.cl/*",
      "https://*.mercadolibre.com.co/*",
      "https://*.mercadolibre.co.cr/*",
      "https://*.mercadolibre.com.do/*",
      "https://*.mercadolibre.com.ec/*",
      "https://*.mercadolibre.com.gt/*",
      "https://*.mercadolibre.hn/*",
      "https://*.mercadolibre.com.mx/*",
      "https://*.mercadolibre.com.ni/*",
      "https://*.mercadolibre.pa/*",
      "https://*.mercadolibre.pe/*",
      "https://*.mercadolibre.com.py/*",
      "https://*.mercadolibre.uy/*",
      "https://*.mercadolibre.com.ve/*"
    ],
    "js": ["assets/content.js"],
    "css": ["assets/content.css"],
    "all_frames": true,
    "run_at": "document_idle"
  }],
  "icons": { "16": "favicon.svg", "48": "favicon.svg", "128": "favicon.svg" }
}
